# Environment Configuration Template for GeoAI Recommendation Backend

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Model Ingestion Settings
MODEL_ID=OpenVINO/Qwen2.5-1.5B-Instruct-int4-ov
BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
OPENVINO_DEVICE=CPU
MAX_NEW_TOKENS=512
TEMPERATURE=0.0
ENABLE_MODEL_INFERENCE=true

# External API Configuration
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OSRM_URL=https://router.project-osrm.org

# Performance and Politeness
HTTP_TIMEOUT_SECONDS=8.0
CACHE_TTL_SECONDS=900
NOMINATIM_MIN_DELAY=1.0
NOMINATIM_USER_AGENT=GeoAI-Hackathon-2026-CSRE-IITB/1.0 (academic.research.geospatial@iitb.ac.in)
